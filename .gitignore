.vscode/
*.log
.DS_Store
Thumbs.db

# Uploads directory (keep the .gitkeep placeholder, ignore all actual files)
/uploads/*
!/uploads/.gitkeep

# Environment file — contains DB credentials, must NEVER be committed
.env

# Password reset token log — contains live tokens, must NEVER be committed
email_log.txt

# Python bytecode cache
__pycache__/
*.pyc
*.pyo

# Trained ML model (large binary, regenerated from train_model.py)
ml_models/urgency_model.json
ml_models/label_encoders.json
.gemini/
.codex_backups/
ml_models/site-packages/
ml_models/venv/

# DB export dumps — large, regenerated on demand
fairmedalloc_export.sql

# Scratch / one-off test scripts
scratch/

.venv_solver/
backup.sql
backup_utf8.sql

