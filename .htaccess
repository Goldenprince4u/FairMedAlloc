# FairMedAlloc — Apache Access Control
# =====================================
# Blocks direct web access to sensitive files that must never be publicly readable.

# --- 0. Block password reset token log (contains live tokens — NEVER expose publicly) ---
<Files "email_log.txt">
    Order Allow,Deny
    Deny from all
</Files>

# --- 1. Block the master document (contains full DB schema and architecture notes) ---
<Files "master_document.txt">
    Order Allow,Deny
    Deny from all
</Files>

# --- 2. Block all Python scripts in the web root (dev/utility scripts) ---
<FilesMatch "^(generate_setup|fix_female_blocks|rebuild_female_hostels)\.py$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# --- 3. Block the .env file (DB credentials) ---
<Files ".env">
    Order Allow,Deny
    Deny from all
</Files>

# --- 4. Block raw SQL files ---
<FilesMatch "\.(sql)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# --- 5. Block ML model artifacts and Python files ---
# (These are executed or consumed server-side only, never via HTTP)
<FilesMatch "\.(json|py|pkl|bat|whl)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^ml_models/(site-packages|__pycache__)/ - [F,L,NC]
    RewriteRule ^ml_models/(hostel_medical_dataset\.csv|xgboost_hostel_model\.pkl|start_ml_service\.bat)$ - [F,L,NC]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net data:; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'self';"
</IfModule>

# --- 6. Force UTF-8 character encoding for all PHP files ---
# This prevents the Naira sign and other Unicode chars from rendering garbled
AddDefaultCharset UTF-8
Options -Indexes
