# FairMedAlloc environment template
#
# Local development:
# - copy this file to `.env`
# - fill in your local database values
#
# Railway:
# - do not upload a real `.env`
# - create these keys as Railway service variables instead

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=fairmedalloc

# Local loopback ML scoring service inside the same machine/container.
ML_SERVICE_URL=http://127.0.0.1:5051
ML_SERVICE_TIMEOUT=120

# Startup / background worker tuning
DB_CONNECT_TIMEOUT=120
FAIRMED_ENABLE_ML_SERVICE=1
FAIRMED_ENABLE_WORKER=1
FAIRMED_WORKER_INTERVAL=2
FAIRMED_WORKER_MAX_JOBS=1
FAIRMED_ML_BIND_HOST=127.0.0.1
FAIRMED_ML_BIND_PORT=5051

# Local Windows/XAMPP Python path example.
# In Docker/Railway this is already provided by the image.
PYTHON_BIN=C:/path/to/your/python.exe
FAIRMED_PYTHON_BIN=C:/path/to/your/python.exe

# Local model path example.
ML_MODEL_PICKLE_PATH=ml_models/xgboost_hostel_model.pkl
